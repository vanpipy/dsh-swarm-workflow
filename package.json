{
  "name": "dsh-swarm-workflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ships the swarm execution policy verbatim: injects the global execution policy into the Coordinator, a scoped view of it plus the role methods into every delegated lane, and registers the swarm-engineering skill. Every host-specific fact lives in runtime-note.md.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./prompt-overlay.md": "./prompt-overlay.md",
    "./runtime-note.md": "./runtime-note.md",
    "./swarm-prompt.md": "./swarm-prompt.md",
    "./skills/*.md": "./skills/*.md"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "prompt-overlay.md", "runtime-note.md", "swarm-prompt.md", "skills/*.md", "test/"],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
