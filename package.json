{
  "name": "@sages/swarm-workflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ships the swarm orchestration policy: prompts the session's main agent as the Coordinator, gives delegated subagents a role-specific worker prompt, and registers the swarm-engineering skill.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./swarm-prompt.md": "./swarm-prompt.md",
    "./swarm-worker-prompt.md": "./swarm-worker-prompt.md",
    "./skills/*.md": "./skills/*.md"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "swarm-prompt.md", "swarm-worker-prompt.md", "skills/*.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
